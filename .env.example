# ================= DEV LOCAL (SQLite) =================
# Crée prisma/dev.db automatiquement (zéro installation)
DATABASE_URL="file:./dev.db"

# ================= PROD (Vercel) =================
# Base PostgreSQL hébergée (Neon, Supabase, Vercel Postgres…)
# Renseignez la même valeur dans Vercel (Settings → Environment Variables).
# Après l'avoir créée, poussez le schéma UNE FOIS depuis chez vous :
#   DATABASE_URL="postgresql://user:pass@host:5432/sabrenshop?sslmode=require" npm run db:push:prod
#   DATABASE_URL="postgresql://user:pass@host:5432/sabrenshop?sslmode=require" npm run db:seed:prod
# DATABASE_URL="postgresql://user:password@host:5432/sabrenshop?sslmode=require"

# Auth.js (v5) — obligatoire en prod
# AUTH_SECRET : générez avec :  openssl rand -base64 32
AUTH_SECRET="changez-moi"
# En local : http://localhost:3000 — en prod : https://<projet>.vercel.app
AUTH_URL="http://localhost:3000"

# URL publique du site (partage/SEO)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ================= Vercel Blob (images admin) =================
# STORE PUBLIC obligatoire (Vercel : Storage → Create Database → Blob → access: Public).
# Laisser VIDE en dev (les images partent alors dans /public/uploads).
SABREEN_STORE_ID=""
SABREEN_READ_WRITE_TOKEN=""

# Numéro WhatsApp affiché dans la boutique
NEXT_PUBLIC_WHATSAPP_NUMBER="22789148454"

# ================= Emails (newsletter + réinitialisation mot de passe) =================
# Envoi via votre propre compte Gmail (SMTP). Google impose un « mot de passe d'application » :
#   1. Activez la validation en 2 étapes sur votre compte Google
#      (https://myaccount.google.com/security)
#   2. Créez un mot de passe d'application :
#      https://myaccount.google.com/apppasswords
#   3. Collez-le dans SMTP_PASS (16 caractères, sans espaces).
# Si absents, les emails sont journalisés (console) et les liens de réinitialisation
# ne sont PAS livrés (ajoutez-les en prod !).
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="votre@gmail.com"
# SMTP_PASS="le-mot-de-passe-d-application"
# Expéditeur affiché (facultatif, par défaut = SMTP_USER).
# SMTP_FROM="Sabreen'Shop <votre@gmail.com>"

# ================= Récap newsletter quotidien (cron Vercel, 9h00 UTC) =================
# Facultatif : sécurise /api/newsletter/digest (si défini, un appel externe sans ce secret
# est rejeté). Si vous définissez le CRON_SECRET standard de Vercel, le header
# Authorization généré par Vercel est accepté automatiquement.
# NEWSLETTER_CRON_SECRET="changez-moi"